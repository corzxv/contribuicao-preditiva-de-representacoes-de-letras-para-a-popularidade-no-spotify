# Dados: brutos imutáveis e produtos reconstruíveis não são versionados
data/raw/**
data/interim/**
data/processed/**
data/rejected/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/rejected/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
*.csv
*.jsonl
*.json.gz
*.zip

# Relatórios gerados e logs volumosos
reports/figures/*.png
reports/tables/*.csv
logs/
*.log

# Editores e sistema operacional
.DS_Store
Thumbs.db
.idea/
.vscode/
